ErrorDocument 404 /404.html
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTP_HOST} !^(www\.)?sheships\.dev$ [NC]
  RewriteCond %{HTTP_HOST} sheships\. [NC]
  RewriteRule ^ https://sheships.dev%{REQUEST_URI} [L,R=301]

  RewriteRule ^faq/?$ faq/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(index|404)\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
